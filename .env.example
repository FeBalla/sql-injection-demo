# Copy to .env and adjust. Every value has a working default for local use,
# so .env is only needed to change passwords or enable BigQuery.

# --- Postgres (local container only) ---
# These match the docker-compose.yml defaults. Postgres applies them only when its
# volume is first created: after changing them, run `docker compose down -v`.
POSTGRES_DB=injection_lab
POSTGRES_USER=lab_owner
POSTGRES_PASSWORD=lab_owner_local
APP_DB_USER=lab_app
APP_DB_PASSWORD=lab_app_local

# --- BigQuery (optional) ---
# Run infra/gcp/setup.sh first, then uncomment these lines.
# COMPOSE_FILE=docker-compose.yml:docker-compose.bigquery.yml
# GCP_PROJECT_ID=your-project-id
# BQ_DATASET=injection_lab
# BQ_LOCATION=US
# Absolute path to the ADC file created by the setup script's final command:
# GCP_ADC_FILE=/Users/you/.config/gcloud-injection-lab/application_default_credentials.json
